# video_studio/.env.example
# Скопируйте в .env и заполните реальными значениями. .env не коммитится (см. .gitignore).

# --- Хранилище (см. config/paths.py) ---
# Локально можно не задавать — по умолчанию используется ~/video_studio_home.
# На Colab ОБЯЗАТЕЛЬНО задаётся в notebooks/colab_setup.ipynb ДО импорта
# остального пакета, указывая на смонтированный Google Drive:
#   VIDEO_STUDIO_HOME=/content/drive/MyDrive/video_studio_home
VIDEO_STUDIO_HOME=

# --- API-ключи (см. core/accounts/account_manager.py) ---
DEEPSEEK_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
ELEVENLABS_API_KEY=

# --- Flow-аккаунты (Google Flow/Veo, см. core/providers/, REFACTOR_PLAN.md) ---
# Один из трёх вариантов — см. account_manager.py:
# FLOW_ACCOUNTS_JSON={"accounts": [...]}
# FLOW_ACCOUNT_1_PROFILE_PATH=...
# FLOW_ACCOUNT_1_DAILY_LIMIT=5

# OASIS_STUDIO_DIR и SUBTITLE_SERVICE_DIR из версии ДО объединения репозиториев
# БОЛЬШЕ НЕ ИСПОЛЬЗУЮТСЯ — make_subs/style_manager импортируются напрямую
# из пакета asr/, а subtitle_api запускается через sys.executable, не через
# путь к чужому venv. См. COLAB_MIGRATION_PLAN.md, раздел 3.2.
